# Source archive allowlist: everything else stays local.
/*
!/.gitignore
!/.clang-format
!/CMakeLists.txt
!/README.md
!/README.en.md
!/CHANGELOG.md
!/src/
!/resources/
!/third_party/
!/tests/
!/scripts/
!/installer/
!/cmake/
!/docs/
/docs/*

/scripts/*
!/scripts/build.ps1
!/scripts/Get-InnoSetup.ps1
!/scripts/Get-WinUI.ps1
!/scripts/Get-Ocr.ps1
!/scripts/Test-Installer.ps1

/installer/*
!/installer/setup.iss
!/installer/languages/

# Keep source and test fixtures, not local notes or generated files.
*.md
!/README.md
!/README.en.md
!/CHANGELOG.md
!/docs/architecture.md
!/docs/translation-core-design.md
*.log
!/AGENTS.md
!/tests/fixtures/upstream/SOURCES.md
*.user
*.pdb
*.obj
*.lib
*.exe
*.dll
*.zip
.env
.env.*
.vs/
Thumbs.db
Desktop.ini

# Release sidecar checksums are not distributed.
*.sha256
*.sha265
