# Source archive allowlist: everything else stays local.
/*
!/.gitignore
!/.clang-format
!/CMakeLists.txt
!/README.md
!/src/
!/resources/
!/third_party/
!/scripts/
!/installer/
!/cmake/

/scripts/*
!/scripts/build.ps1
!/scripts/Get-InnoSetup.ps1
!/scripts/Get-WinUI.ps1
!/scripts/Get-Ocr.ps1

/installer/*
!/installer/setup.iss
!/installer/languages/

# Keep source and build files; exclude local notes, tests, and generated artifacts.
*.md
!/README.md
/docs/
*.log
*.user
*.pdb
*.obj
*.lib
*.exe
*.dll
*.zip
.env
.env.*
.vs/
Thumbs.db
Desktop.ini

# Release sidecar checksums are not distributed.
*.sha256
*.sha265
