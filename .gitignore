# Source archive allowlist: everything else stays local.
/*
!/.gitignore
!/CMakeLists.txt
!/README.md
!/CHANGELOG.md
!/src/
!/resources/
!/third_party/
!/tests/
!/scripts/
!/installer/

/scripts/*
!/scripts/build.ps1
!/scripts/Get-InnoSetup.ps1

/installer/*
!/installer/setup.iss
!/installer/languages/

# Keep source and test fixtures, not local notes or generated files.
*.md
!/README.md
!/CHANGELOG.md
*.log
*.user
*.pdb
*.obj
*.lib
*.exe
*.dll
*.zip
.env
.env.*
.vs/
Thumbs.db
Desktop.ini
