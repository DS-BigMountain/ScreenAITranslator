<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="UiShell" Color="#F3F3F3"/><SolidColorBrush x:Key="UiPage" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="UiCard" Color="White"/><SolidColorBrush x:Key="UiText" Color="#1B1B1B"/>
          <SolidColorBrush x:Key="UiSecondary" Color="#5E5E5E"/><SolidColorBrush x:Key="UiBorder" Color="#E2E2E2"/>
          <SolidColorBrush x:Key="UiHover" Color="#EAEAEA"/><SolidColorBrush x:Key="UiSelected" Color="#E7E7E7"/>
          <SolidColorBrush x:Key="UiUser" Color="#E4F0FC"/><SolidColorBrush x:Key="UiAccent" Color="#3264BC"/>
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3264BC"/>
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2C5BAE"/>
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#28539E"/><SolidColorBrush x:Key="AccentButtonBackground" Color="#3264BC"/><SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2C5BAE"/><SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#28539E"/><SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#3264BC"/><SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#3264BC"/><SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#2C5BAE"/>
          <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="UiShell" Color="#202020"/><SolidColorBrush x:Key="UiPage" Color="#272727"/>
          <SolidColorBrush x:Key="UiCard" Color="#303030"/><SolidColorBrush x:Key="UiText" Color="#F2F2F2"/>
          <SolidColorBrush x:Key="UiSecondary" Color="#BFBFBF"/><SolidColorBrush x:Key="UiBorder" Color="#424242"/>
          <SolidColorBrush x:Key="UiHover" Color="#363636"/><SolidColorBrush x:Key="UiSelected" Color="#383838"/>
          <SolidColorBrush x:Key="UiUser" Color="#16435E"/><SolidColorBrush x:Key="UiAccent" Color="#60CDFF"/>
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF"/>
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#58BCEB"/>
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#50ACD8"/><SolidColorBrush x:Key="AccentButtonBackground" Color="#60CDFF"/><SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#58BCEB"/><SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#50ACD8"/><SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#60CDFF"/><SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#60CDFF"/><SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#58BCEB"/>
          <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="UiShell" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="UiPage" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="UiCard" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="UiText" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="UiSecondary" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="UiBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="UiHover" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="UiSelected" Color="{ThemeResource SystemColorHighlightColor}"/>
          <SolidColorBrush x:Key="UiUser" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="UiAccent" Color="{ThemeResource SystemColorHotlightColor}"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{ThemeResource UiText}"/></Style>
      <Style x:Key="Note" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{ThemeResource UiSecondary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
      <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource UiCard}"/><Setter Property="BorderBrush" Value="{ThemeResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="24"/></Style>
      <Style x:Key="SettingRow" TargetType="Grid"><Setter Property="Padding" Value="22,17"/><Setter Property="ColumnSpacing" Value="24"/><Setter Property="MinHeight" Value="72"/></Style>
      <Style x:Key="Divider" TargetType="Border"><Setter Property="Background" Value="{ThemeResource UiBorder}"/><Setter Property="Height" Value="1"/></Style>
      <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource UiSecondary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ButtonSurface.Background" Value="{ThemeResource UiHover}"/></VisualState.Setters></VisualState>
              <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ButtonSurface.Background" Value="{ThemeResource UiSelected}"/></VisualState.Setters></VisualState>
              <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ButtonSurface.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateManager.VisualStateGroups>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="7"/></Style>
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="Background" Value="{ThemeResource UiAccent}"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="18,9"/><Setter Property="FontSize" Value="16"/></Style>
      <Style x:Key="NavigationItem" TargetType="NavigationViewItem"><Setter Property="FontSize" Value="16"/><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="8,2"/></Style>
      <Style x:Key="RecognitionChoice" TargetType="ToggleButton">
        <Setter Property="Padding" Value="18,16"/><Setter Property="Background" Value="{ThemeResource UiCard}"/><Setter Property="BorderBrush" Value="{ThemeResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ChoiceSurface.Background" Value="{ThemeResource UiHover}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ChoiceSurface.Opacity" Value="0.45"/></VisualState.Setters></VisualState></VisualStateGroup><VisualStateGroup x:Name="CheckStates"><VisualState x:Name="Unchecked"/><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="ChoiceSurface.BorderBrush" Value="{ThemeResource UiAccent}"/><Setter Target="ChoiceSurface.Background" Value="{ThemeResource UiUser}"/></VisualState.Setters></VisualState><VisualState x:Name="Indeterminate"/></VisualStateGroup></VisualStateManager.VisualStateGroups>
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </Border></ControlTemplate></Setter.Value></Setter>
      </Style>
      <DataTemplate x:Key="UserMessageTemplate">
        <StackPanel HorizontalAlignment="Right" Spacing="8">
          <TextBlock Text="你" Style="{StaticResource Note}" HorizontalAlignment="Right"/>
          <Border x:Name="MessageBubble" Background="{ThemeResource UiUser}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="20,20"><StackPanel x:Name="MessageContent" Spacing="10"/></Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="TranslationMessageTemplate">
        <StackPanel HorizontalAlignment="Left" Spacing="8">
          <TextBlock Text="译文" Style="{StaticResource Note}"/>
          <Border x:Name="MessageBubble" Background="{ThemeResource UiCard}" BorderBrush="{ThemeResource UiBorder}" BorderThickness="1" CornerRadius="8" Padding="20,20"><StackPanel x:Name="MessageContent" Spacing="10"/></Border>
          <Button x:Name="CopyTranslation" Style="{StaticResource IconButton}" HorizontalAlignment="Left" AutomationProperties.Name="复制译文" ToolTipService.ToolTip="复制译文">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M9 9 H20 A2 2 0 0 1 22 11 V22 A2 2 0 0 1 20 24 H9 A2 2 0 0 1 7 22 V11 A2 2 0 0 1 9 9 M16 5 V3 A2 2 0 0 0 14 1 H3 A2 2 0 0 0 1 3 V14 A2 2 0 0 0 3 16 H4" Stroke="{ThemeResource UiSecondary}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
          </Button>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid x:Name="CaptionBar" Height="56" Visibility="Collapsed" IsHitTestVisible="False" Padding="18,0,150,0" Background="{ThemeResource UiShell}">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image x:Name="CaptionIcon" Width="18" Height="18"/><TextBlock Text="你给我翻译翻译什么叫翻译" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" FontFamily="Microsoft YaHei UI" FontSize="15"
                  IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left" OpenPaneLength="250"
                  CompactPaneLength="48" IsPaneToggleButtonVisible="False" IsPaneOpen="True" IsTitleBarAutoPaddingEnabled="False" AlwaysShowHeader="False" Background="{ThemeResource UiShell}">
    <NavigationView.Resources><x:Double x:Key="NavigationViewItemOnLeftMinHeight">48</x:Double><x:Double x:Key="NavigationViewPaneHeaderRowMinHeight">24</x:Double><x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">18</x:Double><x:Double x:Key="NavigationViewSelectionIndicatorHeight">22</x:Double><Thickness x:Key="NavigationViewItemContentPresenterMargin">8,0,0,0</Thickness><Thickness x:Key="NavigationViewItemOnLeftIconBoxMargin">4,0,0,0</Thickness></NavigationView.Resources><NavigationView.PaneHeader><Border Height="24"/></NavigationView.PaneHeader><NavigationView.MenuItems>
      <NavigationViewItem Content="文本翻译" Tag="0" Style="{StaticResource NavigationItem}"><NavigationViewItem.Icon><PathIcon Data="F0 M4,2 H14 A3,3 0 0 1 17,5 V11 A3,3 0 0 1 14,14 H6 L1,18 V5 A3,3 0 0 1 4,2 Z M4,3.5 A1.5,1.5 0 0 0 2.5,5 V14.8 L5.5,12.5 H14 A1.5,1.5 0 0 0 15.5,11 V5 A1.5,1.5 0 0 0 14,3.5 Z M9,15 H10.5 V18 A1.5,1.5 0 0 0 12,19.5 H18.5 L21.5,21.8 V12 A1.5,1.5 0 0 0 20,10.5 H18 V9 H20 A3,3 0 0 1 23,12 V25 L18,21 H12 A3,3 0 0 1 9,18 Z"/></NavigationViewItem.Icon></NavigationViewItem>
      <NavigationViewItem Content="截图翻译" Tag="1" Style="{StaticResource NavigationItem}"><NavigationViewItem.Icon><PathIcon Data="M7,2 H4 A2,2 0 0 0 2,4 V7 H3.5 V4 A0.5,0.5 0 0 1 4,3.5 H7 Z M17,2 H20 A2,2 0 0 1 22,4 V7 H20.5 V4 A0.5,0.5 0 0 0 20,3.5 H17 Z M2,17 V20 A2,2 0 0 0 4,22 H7 V20.5 H4 A0.5,0.5 0 0 1 3.5,20 V17 Z M22,17 V20 A2,2 0 0 1 20,22 H17 V20.5 H20 A0.5,0.5 0 0 0 20.5,20 V17 Z M7,7 H17 V8.5 H7 Z M7,11 H17 V12.5 H7 Z M7,15 H13 V16.5 H7 Z"/></NavigationViewItem.Icon></NavigationViewItem>
    </NavigationView.MenuItems>
    <NavigationView.FooterMenuItems><NavigationViewItem Content="设置" Icon="Setting" Tag="2" Style="{StaticResource NavigationItem}" Margin="8,2,8,14"/></NavigationView.FooterMenuItems>
    <Border Background="{ThemeResource UiPage}" BorderBrush="{ThemeResource UiBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,8,8">
      <Grid x:Name="ContentLayout" Padding="36,34,36,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PageHeader" ColumnSpacing="16" Margin="0,0,0,33">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="8">
            <TextBlock x:Name="PageTitle" Text="文本翻译" FontFamily="Microsoft YaHei UI" FontSize="34" FontWeight="Bold"/>
            <HyperlinkButton x:Name="TextConnection" Padding="0" MinHeight="24" HorizontalAlignment="Left" Foreground="{ThemeResource UiSecondary}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="TextConnectionLabel" Text="模型连接" FontSize="14" Foreground="{ThemeResource UiSecondary}" TextTrimming="CharacterEllipsis"/><FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource UiSecondary}"/></StackPanel>
            </HyperlinkButton>
            <TextBlock x:Name="ScreenSubtitle" Text="框选屏幕内容，在对应位置显示中文译文。" Style="{StaticResource Note}" Visibility="Collapsed"/>
            <SelectorBar x:Name="SettingsTabs" Visibility="Collapsed" Margin="0,14,0,0"><SelectorBarItem Text="常规" Tag="0"/><SelectorBarItem Text="模型连接" Tag="1"/><SelectorBarItem Text="显示效果" Tag="2"/><SelectorBarItem Text="关于" Tag="3"/></SelectorBar>
          </StackPanel>
          <Button x:Name="ConversationMenu" Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="会话操作" ToolTipService.ToolTip="会话操作">
            <FontIcon Glyph="&#xE712;" FontSize="18"/>
            <Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="PasteImage" Text="粘贴图片" Icon="Paste"/><MenuFlyoutSeparator/><MenuFlyoutItem x:Name="ClearConversation" Text="清空会话" Icon="Delete"/></MenuFlyout></Button.Flyout>
          </Button>
        </Grid>
        <Grid x:Name="TextPage" Grid.Row="1" RowSpacing="22" AllowDrop="True">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="LanguageCard" Style="{StaticResource Card}" Padding="20,18" MinHeight="80">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <TextBlock Text="自动检测原文" FontSize="15" Foreground="{ThemeResource UiSecondary}" VerticalAlignment="Center"/>
              <FontIcon Glyph="&#xE72A;" FontSize="18" VerticalAlignment="Center"/>
              <ComboBox x:Name="TextTarget" Width="200" MinHeight="42" FontSize="16" AutomationProperties.Name="目标语言"/>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1">
            <StackPanel x:Name="TextEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="400">
              <TextBlock Text="输入文字或添加图片" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="选择目标语言后翻译，回复仅包含译文。" Style="{StaticResource Note}" HorizontalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Conversation" Spacing="32" Padding="0,28,2,20"/></ScrollViewer>
          </Grid>
          <Border x:Name="ComposerCard" Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <ScrollViewer x:Name="AttachmentScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="125" Margin="18,14,18,0" Visibility="Collapsed"><StackPanel x:Name="ImageAttachments" Orientation="Horizontal" Spacing="12"/></ScrollViewer>
              <Grid Grid.Row="1">
                <TextBox x:Name="TextInput" PlaceholderText="输入要翻译的文字，或粘贴图片…" AcceptsReturn="True" TextWrapping="Wrap" IsSpellCheckEnabled="False" MaxLength="12000" FontSize="16" BorderThickness="0" Background="Transparent" Padding="20,18,20,8" MinHeight="128" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/><Thickness x:Key="TextControlBorderThemeThickness">0</Thickness><Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </TextBox.Resources>
                </TextBox>
                <Thumb x:Name="ComposerResize" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,5" AutomationProperties.Name="调整输入区高度">
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Data="M4 13 L13 4 M8 13 L13 8" Stroke="{ThemeResource UiSecondary}" StrokeThickness="1" Opacity="0.7"/></Grid></ControlTemplate></Thumb.Template>
                </Thumb>
              </Grid>
              <Grid x:Name="ComposerToolbar" Grid.Row="2" Padding="14,12,14,18" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Button x:Name="AddImage" Style="{StaticResource FlatButton}" Foreground="{ThemeResource UiText}" FontSize="15">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M21 13 V20 A2 2 0 0 1 19 22 H4 A2 2 0 0 1 2 20 V5 A2 2 0 0 1 4 3 H13 M17 3 H23 M20 0 V6 M2 17 L8 11 L14 17 L17 14 L21 18 M8 7 A1 1 0 1 0 8 9 A1 1 0 1 0 8 7" Stroke="{ThemeResource UiText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="添加图片" FontSize="15"/></StackPanel>
                  </Button>
                  <TextBlock x:Name="SendHint" Text="Enter 翻译 · Shift+Enter 换行" FontSize="12" Foreground="{ThemeResource UiSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button x:Name="RetryText" Content="重试" Visibility="Collapsed" MinHeight="42"/>
                  <Button x:Name="StopText" Content="停止" Visibility="Collapsed" MinHeight="42"/>
                  <Button x:Name="SendText" Style="{StaticResource PrimaryButton}" MinWidth="100">
                    <StackPanel Orientation="Horizontal" Spacing="10"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="M12 21 V3 M5 10 L12 3 L19 10" Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="翻译" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="TextStatus" Grid.Row="3" Style="{StaticResource Note}" Margin="20,0,20,14" Visibility="Collapsed"/>
            </Grid>
          </Border>
        </Grid>
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <Grid Padding="0,0,4,4">
            <StackPanel x:Name="ScreenPage" Spacing="20" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Padding="22,20">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="Translate" Content="框选翻译" Style="{StaticResource PrimaryButton}"/><Button x:Name="TranslateFixed" Content="翻译上次区域" MinHeight="42" Padding="16,8"/></StackPanel>
                  <HyperlinkButton x:Name="OpenShortcuts" Grid.Column="1" Content="设置快捷键" Foreground="{ThemeResource UiAccent}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}"><StackPanel Spacing="18">
                <TextBlock Text="识别方式" Style="{StaticResource SectionTitle}"/>
                <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <ToggleButton x:Name="VisionChoice" Style="{StaticResource RecognitionChoice}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="5"><TextBlock Text="AI 识图" FontWeight="SemiBold"/><TextBlock Text="由视觉模型识别并翻译图片" Style="{StaticResource Note}"/></StackPanel></ToggleButton>
                  <ToggleButton x:Name="OcrChoice" Grid.Column="1" Style="{StaticResource RecognitionChoice}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="5"><TextBlock Text="本地 OCR" FontWeight="SemiBold"/><TextBlock Text="先识别原文，仅向服务提交文字" Style="{StaticResource Note}"/></StackPanel></ToggleButton>
                </Grid>
                <ComboBox x:Name="TranslationMode" Visibility="Collapsed"><ComboBoxItem Content="OCR 文字翻译"/><ComboBoxItem Content="AI 识图翻译"/></ComboBox>
                <ComboBox x:Name="Quality" Header="截图分辨率" HorizontalAlignment="Stretch"><ComboBoxItem Content="速度优先 · 1280 px"/><ComboBoxItem Content="均衡 · 1600 px"/><ComboBoxItem Content="清晰优先 · 2200 px"/></ComboBox>
                <ComboBox x:Name="OcrMode" Header="原文语言" HorizontalAlignment="Stretch"><ComboBoxItem Content="自动识别（本地）"/><ComboBoxItem Content="英语"/><ComboBoxItem Content="日语"/><ComboBoxItem Content="韩语"/></ComboBox>
                <HyperlinkButton x:Name="ScreenConnection" Padding="0" HorizontalAlignment="Left" Foreground="{ThemeResource UiSecondary}"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="0"><StackPanel>
                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="完整翻译全部文字" FontWeight="SemiBold"/><TextBlock Text="保留页面、字幕及对话中的可翻译内容。" Style="{StaticResource Note}"/></StackPanel><ToggleSwitch x:Name="TranslateAll" Grid.Column="1" VerticalAlignment="Center"/></Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="在原文位置显示译文" FontWeight="SemiBold"/><TextBlock Text="关闭后使用独立译文框。" Style="{StaticResource Note}"/></StackPanel><ToggleSwitch x:Name="SpatialOverlay" Grid.Column="1" VerticalAlignment="Center"/></Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="译文的字体与颜色" VerticalAlignment="Center"/><HyperlinkButton x:Name="OpenAppearance" Grid.Column="1" Content="显示设置  ›" Foreground="{ThemeResource UiAccent}"/></Grid>
              </StackPanel></Border>
              <TextBlock Text="拖动译文框边缘可重新定位；工具条提供原图、全文阅读、复制和关闭操作。" Style="{StaticResource Note}"/>
            </StackPanel>
            <StackPanel x:Name="SettingsPage" Spacing="24" Visibility="Collapsed">
              <StackPanel x:Name="SettingsGeneral" Spacing="20">
                <Border Style="{StaticResource Card}" Padding="0"><StackPanel>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="登录 Windows 后在后台启动" FontWeight="SemiBold"/><TextBlock Text="启动后保留托盘与快捷键入口。" Style="{StaticResource Note}"/></StackPanel><ToggleSwitch x:Name="Startup" Grid.Column="1" VerticalAlignment="Center"/></Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="显示系统托盘图标" FontWeight="SemiBold"/><TextBlock Text="关闭托盘前，需要设置“打开设置”快捷键。" Style="{StaticResource Note}"/></StackPanel><ToggleSwitch x:Name="Tray" Grid.Column="1" VerticalAlignment="Center"/></Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="使用 Ctrl+Enter 翻译" FontWeight="SemiBold"/><TextBlock Text="关闭时使用 Enter 翻译，Shift+Enter 换行。" Style="{StaticResource Note}"/></StackPanel><ToggleSwitch x:Name="TextCtrlEnter" Grid.Column="1" VerticalAlignment="Center"/></Grid>
                </StackPanel></Border>
                <StackPanel Spacing="12"><TextBlock Text="快捷键" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}" Padding="0"><StackPanel>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="框选翻译" VerticalAlignment="Center"/><TextBox x:Name="Hotkey0" Grid.Column="1" Width="176" PlaceholderText="未设置"/></Grid><Border Style="{StaticResource Divider}"/>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="翻译上次区域" VerticalAlignment="Center"/><TextBox x:Name="Hotkey1" Grid.Column="1" Width="176" PlaceholderText="未设置"/></Grid><Border Style="{StaticResource Divider}"/>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="打开设置" VerticalAlignment="Center"/><TextBox x:Name="Hotkey2" Grid.Column="1" Width="176" PlaceholderText="未设置"/></Grid>
                </StackPanel></Border><TextBlock Text="选中输入框后按下组合键，退格键清除。编辑期间暂停全部全局快捷键。" Style="{StaticResource Note}"/></StackPanel>
                <Expander x:Name="ContextExpander" Header="翻译偏好" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="18">
                  <ToggleSwitch x:Name="ContextEnabled" Header="使用最近翻译上下文"/><NumberBox x:Name="ContextSize" Header="上下文数量" Minimum="5" Maximum="10" SpinButtonPlacementMode="Compact"/>
                  <TextBlock Text="文本会话与截图上下文分别在内存中管理。" Style="{StaticResource Note}"/><Button x:Name="ClearContext" Content="清空上下文"/>
                  <TextBox x:Name="Prompt" Header="截图翻译要求" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxLength="8192"/>
                </StackPanel></Expander>
              </StackPanel>
              <StackPanel x:Name="SettingsConnection" Spacing="20" Visibility="Collapsed">
                <Border Style="{StaticResource Card}"><StackPanel Spacing="18">
                  <TextBlock Text="模型连接" Style="{StaticResource SectionTitle}"/><TextBlock Text="文本翻译与截图翻译共用此连接。" Style="{StaticResource Note}"/>
                  <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="Provider" Header="服务提供方" HorizontalAlignment="Stretch"/><ComboBox x:Name="Model" Grid.Column="1" Header="模型" IsEditable="True" HorizontalAlignment="Stretch"/></Grid>
                  <TextBox x:Name="BaseUrl" Header="API 地址"/><PasswordBox x:Name="Key" Header="API 密钥" PasswordRevealMode="Peek"/><TextBox x:Name="ServiceRegion" Header="Azure 服务区域（可选）" Visibility="Collapsed" MaxLength="128"/>
                  <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="FetchModels" Content="获取模型列表"/><Button x:Name="TestApi" Content="测试 API"/><ProgressRing x:Name="ApiProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed"/></StackPanel>
                  <TextBlock x:Name="ApiResult" Text="图片输入需要当前模型支持视觉识别。" Style="{StaticResource Note}"/>
                </StackPanel></Border>
                <Expander Header="高级连接设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="18">
                  <NumberBox x:Name="Timeout" Header="请求时限（秒）" Minimum="1" Maximum="300" SpinButtonPlacementMode="Compact"/>
                  <ComboBox x:Name="ProxyMode" Header="网络连接方式" HorizontalAlignment="Stretch"><ComboBoxItem Content="系统代理"/><ComboBoxItem Content="直接连接"/><ComboBoxItem Content="自定义 HTTP 代理"/></ComboBox><TextBox x:Name="ProxyAddress" Header="代理地址（主机:端口）"/>
                  <TextBox x:Name="RequestParameters" Header="请求参数（JSON）" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxLength="32768" FontFamily="Consolas"/><Button x:Name="FormatRequestParameters" Content="格式化并校验 JSON"/>
                  <TextBlock Text="默认关闭思考；参数定义以服务文档为准。密钥由 Windows 用户凭据保护。" Style="{StaticResource Note}"/>
                </StackPanel></Expander>
              </StackPanel>
              <StackPanel x:Name="SettingsAppearance" Spacing="20" Visibility="Collapsed">
                <Border Style="{StaticResource Card}"><StackPanel Spacing="20">
                  <TextBlock Text="字体与颜色" Style="{StaticResource SectionTitle}"/><TextBlock Text="用于截图翻译的译文显示。" Style="{StaticResource Note}"/>
                  <ComboBox x:Name="Font" Header="字体" IsEditable="True" HorizontalAlignment="Stretch"/>
                  <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ToggleSwitch x:Name="AutoFont" Header="自动匹配原文字号"/><NumberBox x:Name="FontSize" Grid.Column="1" Header="固定字号（DIP）" Minimum="8" Maximum="144" SpinButtonPlacementMode="Compact"/></Grid>
                  <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ToggleSwitch x:Name="MatchTextColor" Header="匹配原文文字颜色"/><TextBox x:Name="TextColor" Grid.Column="1" Header="文字颜色（RRGGBB）" MaxLength="7"/></Grid>
                  <Border Background="{ThemeResource UiPage}" BorderBrush="{ThemeResource UiBorder}" BorderThickness="1" CornerRadius="6" Padding="22"><StackPanel Spacing="14"><TextBlock Text="显示预览" Style="{StaticResource Note}"/><TextBlock x:Name="FontPreview" Text="翻译结果将在对应位置显示。 Aa 123" FontSize="22" TextWrapping="Wrap"/></StackPanel></Border>
                </StackPanel></Border>
                <Expander Header="描边与背景" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="18"><TextBox x:Name="OutlineColor" Header="描边颜色（RRGGBB）" MaxLength="7"/><NumberBox x:Name="OutlineWidth" Header="描边宽度（DIP）" Minimum="0" Maximum="10" SmallChange="0.5" SpinButtonPlacementMode="Compact"/><NumberBox x:Name="Opacity" Header="复杂背景不透明度（0.1–1.0）" Minimum="0.1" Maximum="1" SmallChange="0.05" SpinButtonPlacementMode="Compact"/></StackPanel></Expander>
              </StackPanel>
              <StackPanel x:Name="SettingsAbout" Spacing="16" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="你给我翻译翻译什么叫翻译" Style="{StaticResource SectionTitle}"/><TextBlock Text="V2.0.0"/><TextBlock Text="支持文本、图片与屏幕区域翻译。" Style="{StaticResource Note}"/></StackPanel></Border></StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <Grid x:Name="SettingsFooter" Grid.Row="2" Margin="0,24,0,0" Padding="0,18,0,0" BorderBrush="{ThemeResource UiBorder}" BorderThickness="0,1,0,0" ColumnSpacing="12" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Status" Text="修改设置后保存生效。" Style="{StaticResource Note}" VerticalAlignment="Center"/><Button x:Name="Apply" Grid.Column="1" Content="保存设置" Style="{StaticResource PrimaryButton}"/><Button x:Name="Close" Grid.Column="2" Content="关闭" MinHeight="42" MinWidth="76"/>
        </Grid>
      </Grid>
    </Border>
  </NavigationView>
</Grid>
